# ──────────────────────────────────────────────────────────────────────────────
# Certharbor, environment configuration template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# Or run `make setup` to copy it and generate secrets/ automatically.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Core deployment
# ──────────────────────────────────────────────────────────────────────────────

# Host IP
# Used as Subject Alternative Name in the self-signed TLS certificate
# and as a DNS name for step-ca. Set this to your server's reachable IP.
HOST_IP=192.168.1.100

# External HTTPS port
# Host port nginx (certharbor-web) publishes, the only published port of the
# UI. Use 8443 if 443 is already occupied. The backend publishes none.
UI_HTTPS_PORT=443

# Time zone
# Used by all containers for logs and UI timestamps.
# Examples: UTC, Europe/London, America/New_York, Asia/Tokyo.
TZ=UTC

# Initial admin password (required on first boot, one-shot)
# Picked up on first boot to create the admin user, when no user rows exist yet.
# After successful boot you can safely remove this line.
# There is NO implicit default: if this is left empty (or unset) and no admin
# user exists yet, the container fails to start (backend/db/schema.go).
# CERTHARBOR_ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# step-ca connection
# ──────────────────────────────────────────────────────────────────────────────

# step-ca API base URL (must be reachable from inside the certharbor container).
CA_URL=https://step-ca:9443

# Path to the step-ca root certificate inside the container.
# Used by the Go app and all `step` CLI calls to verify the CA.
# Default: /home/step/certs/root_ca.crt (matches the step-ca volume mount).
# ROOT_CERT=/home/step/certs/root_ca.crt

# Root CA fingerprint (SHA-256 of the root cert DER; PUBLIC, non-secret).
# When set and $ROOT_CERT is absent or empty, the Go app (main.go, via the
# smallstep/certificates library, no `step` CLI involved) downloads the root
# cert from step-ca on startup (30 retries × 1 s). On failure, startup continues
# with a warning. Get this value from step-ca logs or, from a machine that has
# the step CLI installed:
#   step certificate fingerprint /path/to/root_ca.crt
# CA_FINGERPRINT=

# Inline root CA PEM (highest-precedence root-trust method).
# When set, the Go app writes this PEM to $ROOT_CERT at startup.
# Use for ECS / Kubernetes deployments where a volume mount is not available.
# Overrides CA_FINGERPRINT. Keep this on one line (no embedded newlines) or
# use a multiline block if your secrets manager supports it.
# CA_ROOT_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Provisioner identifier (used for certificate requests).
PROVISIONER=admin

# Provisioner password (plain-env fallback, prefer secrets/ca_password).
# Stored in secrets/ca_password (created by `make setup`). The variable read
# here is PROVISIONER_PASSWORD, not CA_PASSWORD, nothing in the app or the
# entrypoint reads a CA_PASSWORD variable. The value below is only used if you
# run without Docker secrets. Min 8 chars.
# Generate: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
# PROVISIONER_PASSWORD=change-me-min-8-chars

# Path to the provisioner password file inside the container.
# The entrypoint writes PROVISIONER_PASSWORD here when the file does not yet exist.
# PASSWORD_FILE=/opt/certharbor/data/provisioner_password

# Step-CA Docker image
# Pinned by default for reproducible updates. Test before changing.
STEP_CA_IMAGE=smallstep/step-ca:0.30.2

# Step-CA certificate duration limits
# Applied to the default provisioner during clean step-ca initialization.
# 8760h = 1 year, 87600h = 10 years.
STEPCA_DEFAULT_TLS_CERT_DURATION=8760h
STEPCA_MAX_TLS_CERT_DURATION=87600h

# ──────────────────────────────────────────────────────────────────────────────
# TLS, UI serving certificate
# ──────────────────────────────────────────────────────────────────────────────
# UI_TLS_MODE controls how the UI's own HTTPS certificate is obtained.
# All three modes are handled in-process by the Go app itself (main.go,
# tlsbootstrap.go), there is no `step` CLI involved anywhere in this image:
#
#   self-signed
#     Generate a 10-year self-signed EC P-256 cert on first boot if SSL_CERT
#     is absent, via crypto/x509. SANs: IP:HOST_IP, DNS:localhost, and
#     DNS:UI_HOSTNAME (when set). nginx cannot verify this leaf, so behind
#     the bundled origin every proxied request fails with a 503.
#
#   provided
#     Do nothing. Expect the operator to mount a cert+key at SSL_CERT/SSL_KEY
#     before the container starts (volume mount, init container, etc.).
#
#   stepca (the compose default)
#     Request a signed leaf cert from the step-ca managed by this UI, via the
#     smallstep/certificates Go library. Retried up to 30 times (1 s apart);
#     falls back to self-signed on failure. Requires CA_URL, ROOT_CERT (or
#     CA_FINGERPRINT/CA_ROOT_CERT_PEM), and PASSWORD_FILE to be ready, the
#     startup ordering guarantees this. After a successful issue, starts a
#     background renewal goroutine that re-issues at ~2/3 of the cert's
#     validity window. The Go hot-reloader picks up the renewed cert on the
#     next TLS handshake with zero restart. The renewal goroutine is
#     panic-safe and fire-and-forget (same pattern as the Let's Encrypt
#     auto-renewer), a failed attempt is logged and retried, it does not
#     affect the serving app.
UI_TLS_MODE=stepca

# Hostname for the backend's TLS certificate.
#   self-signed: added as an extra DNS SAN alongside HOST_IP and localhost.
#   stepca:      used as the CN/SAN requested from the CA.
# Compose defaults it to certharbor, the name nginx verifies the backend's
# leaf against (proxy_ssl_name). Change it only together with nginx.conf.
# UI_HOSTNAME=certharbor

# Validity requested for the UI's own leaf under UI_TLS_MODE=stepca.
# The background renewer re-issues after roughly two thirds of it, so a short
# value is a testing cadence: the e2e renewal test uses 6m, the shortest the
# CA's own minTLSCertDuration of 5m allows. An unparseable or non-positive
# value falls back to the default with a warning.
# It applies to nginx's web leaf too under WEB_TLS_MODE=stepca.
# UI_CERT_DURATION=8760h

# Paths to the serving TLS certificate and key inside the container.
# These are NOT environment variables the Go app reads: the paths below are
# hardcoded in backend/config/config.go regardless of UI_TLS_MODE, and setting
# SSL_CERT/SSL_KEY here has no effect. Left here only to document the fixed
# paths, which is where your own cert+key must be mounted for UI_TLS_MODE=provided.
# SSL_CERT=/opt/certharbor/ssl/server.crt
# SSL_KEY=/opt/certharbor/ssl/server.key

# Force TLS on, overriding the auto-detect behaviour.
#   true            = always serve HTTPS even if the cert file does not exist yet.
#   false or empty  = auto-detect, serve HTTPS if the cert file exists on disk.
# USE_HTTPS=false is a no-op, not a way to force plain HTTP. It behaves
# identically to leaving this unset. There is no way to force plain HTTP.
# USE_HTTPS=

# ──────────────────────────────────────────────────────────────────────────────
# Web origin (nginx, certharbor-web)
# ──────────────────────────────────────────────────────────────────────────────
# nginx terminates TLS for the public name, serves the SPA under /app/ and
# proxies the API and the server-rendered pages to the backend, verifying the
# backend's leaf against the CA root. That needs UI_TLS_MODE=stepca above (or a
# provided backend leaf chaining to the root it is given).
#
# How nginx gets its own certificate:
#   stepca    the backend issues web.crt for WEB_HOSTNAME from step-ca and
#             renews it; nginx reloads on change with no restart
#   provided  mount web.crt, web.key and the backend's root_ca.crt read-only at
#             /etc/certharbor/ssl in certharbor-web; nginx exits at once if any
#             is missing, and nothing writes into that directory
WEB_TLS_MODE=stepca

# The name browsers use for the origin, e.g. ca.example.com. REQUIRED, with
# no fallback: it is the only name on web.crt and nginx refuses handshakes for
# any other name.
WEB_HOSTNAME=

# Strict-Transport-Security max-age in seconds, sent by nginx on the SPA only.
# Unset sends no HSTS. Do not set it while web.crt chains to a private root
# that browsers would stop accepting: a long policy cannot be undone from the
# server.
# WEB_HSTS_MAX_AGE=31536000

# One tag for both images, so the two halves cannot drift apart by accident.
# BACKEND_IMAGE or WEB_IMAGE pin one half for a deliberate rollback.
IMAGE_TAG=local
# BACKEND_IMAGE=certharbor-backend:local
# WEB_IMAGE=certharbor-web:local

# DNS server nginx re-resolves the backend against on every request.
# WEB_RESOLVER=127.0.0.11

# Seconds between the reload watcher's checks of web.crt and web.key.
# WEB_RELOAD_INTERVAL=60

# Per-address request rate and burst nginx allows before answering 429.
# WEB_RATE_LIMIT=20r/s
# WEB_RATE_BURST=40

# Subnet for the step-network bridge. No service relies on an address in it.
# The default sits outside 172.16.0.0/12, where many corporate VPNs route and
# Docker allocates its own networks. Change it if the host loses routes after
# `make up`, then `docker compose down && docker network rm step-network`.
# STEP_NET_SUBNET=10.213.0.0/24

# ──────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────────────────────────────────────
# The entrypoint constructs DATABASE_URL from POSTGRES_* parts when DATABASE_URL
# is not set. Use DATABASE_URL directly for RDS, managed PG, or Kubernetes.

# Full PostgreSQL DSN (takes precedence over all POSTGRES_* parts below).
# DATABASE_URL=postgres://certharbor:password@postgres:5432/certharbor?sslmode=disable

# Individual connection parts (used only when DATABASE_URL is not set).
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=certharbor
# POSTGRES_DB=certharbor

# PostgreSQL password (plain-env fallback, prefer secrets/postgres_password).
# Stored in secrets/postgres_password (created by `make setup`). Min 8 chars.
# Used by both the postgres container and certharbor (via entrypoint).
# POSTGRES_PASSWORD=change-me-min-8-chars

# ──────────────────────────────────────────────────────────────────────────────
# Application security
# ──────────────────────────────────────────────────────────────────────────────

# Session/CSRF signing key (stored in secrets/secret_key; created by `make setup`).
# The value here is only used if you run without Docker secrets (plain-env fallback).
# Min 32 chars, recommended 48. The app REFUSES to start with the default or a
# key shorter than 32 chars. Keep this SECRET, it signs all session cookies.
# Generate: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48
# SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Secure session cookie
# Keep true for HTTPS production. Set false only for local HTTP development.
SESSION_SECURE=true

# ──────────────────────────────────────────────────────────────────────────────
# Reverse-proxy trust / RealIP
# ──────────────────────────────────────────────────────────────────────────────
# Believe X-Forwarded-For, and only X-Forwarded-For, from the proxy in front
# of the app. Keep true behind the nginx origin (certharbor-web): with it
# false every client is recorded as nginx's address, and five wrong passwords
# from anyone lock everyone out of login for five minutes. Without a proxy in
# front it changes nothing, because no peer is trusted.
TRUST_PROXY=true

# Comma-separated CIDR blocks of the proxies whose forwarding header is
# believed, used verbatim. Leave empty behind the bundled nginx: the app then
# resolves WEB_UPSTREAM_HOST and trusts exactly the addresses it returns,
# re-resolving every 5 seconds, so a recreated nginx container is followed.
# Set it for a proxy the app cannot resolve by name (an ingress, a load
# balancer). Any entry that is not a valid CIDR stops the app at startup. Set
# this too wide and you hand the login rate limiter and the auth log's source
# addresses back to the client. Use the proxy's own address as a /32 (or
# /128) unless it is a pool.
TRUSTED_PROXY_CIDRS=
# TRUSTED_PROXY_CIDRS=10.0.0.7/32,10.0.1.0/24

# Name resolved for the trusted proxy when TRUSTED_PROXY_CIDRS is empty. While
# it does not resolve, forwarding headers are ignored and a warning is logged.
# WEB_UPSTREAM_HOST=certharbor-web

# ──────────────────────────────────────────────────────────────────────────────
# Certificate name policy
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of domain suffixes the UI will ask an issuer to sign.
# A request must equal an entry or be a subdomain of one, matched on label
# boundaries, so "example.com" covers "www.example.com" and "*.example.com" but
# not "evil-example.com". It applies to internal issuance, renewal, and the
# Let's Encrypt path.
#
# When empty (the default) issuance is unrestricted: any manager can have the CA
# sign any name, including one the organisation does not control. The app logs a
# warning at startup saying so.
#
# This constrains what the UI will request. It is NOT an X.509 name policy: a
# caller who talks to step-ca directly bypasses it entirely. Only an x509
# nameConstraints policy in the CA's own ca.json binds that caller, and setting
# this key is no substitute for it.
# ALLOWED_DOMAIN_SUFFIXES=example.com,internal.example.net

# ──────────────────────────────────────────────────────────────────────────────
# Let's Encrypt
# ──────────────────────────────────────────────────────────────────────────────
# The ACME directory Let's Encrypt issuance dials. Defaults to the production
# directory; point it at a local ACME server (pebble, step-ca's own ACME
# provisioner) to exercise issuance without touching Let's Encrypt's rate
# limits. Env-only on purpose: a manager-editable LE setting in the database
# must not be able to repoint where issuance actually goes. The app warns
# loudly at startup whenever this is not the production directory.
# LE_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# ──────────────────────────────────────────────────────────────────────────────
# Public origin
# ──────────────────────────────────────────────────────────────────────────────
# The externally reachable origin, scheme and host (and port if non-default).
# Any path is ignored. Links emailed to users are built from this value only.
#
# Behind nginx it must be nginx's published origin (the WEB_HOSTNAME host),
# with no path: the reset link targets /reset-password at the root, never
# under /app/, because a link already emailed cannot be moved.
#
# REQUIRED for password recovery. It is not derived from the inbound request:
# Host and X-Forwarded-Proto are attacker-controlled, so an unauthenticated
# caller could otherwise trigger a reset for someone else's account and have
# them emailed a valid token pointing at the attacker's domain. When this is
# unset the reset email is not sent, the failure is written to the auth log,
# and the user still sees the same generic message (no account enumeration).
PUBLIC_BASE_URL=https://ca.example.com

# ──────────────────────────────────────────────────────────────────────────────
# Local password login (break-glass)
# ──────────────────────────────────────────────────────────────────────────────
# Set false to disable the username/password form (OIDC must be enabled first).
# Keep true while setting up OIDC so you don't lock yourself out.
LOCAL_LOGIN_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────────
# JumpCloud OIDC SSO
# ──────────────────────────────────────────────────────────────────────────────
# Fill these from your JumpCloud OIDC application settings.
# OIDC_ENABLED=false by default, existing deployments are unaffected.
# Steps to configure in JumpCloud:
#   1. SSO → + Add New Application → Custom OIDC App
#   2. Redirect URI: https://<WEB_HOSTNAME>/auth/oidc/callback, on nginx's
#      published origin and never under /app/: a URI registered with the IdP
#      cannot be changed from here.
#   3. Copy Client ID and Client Secret below.
#   4. Add group attributes (Attribute Name = "groups").
#   5. Set OIDC_GROUP_ADMIN / MANAGER / VIEWER to the JumpCloud group names.
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://oauth.id.jumpcloud.com/
OIDC_CLIENT_ID=your-jumpcloud-client-id
OIDC_CLIENT_SECRET=your-jumpcloud-client-secret
OIDC_REDIRECT_URL=https://your-host/auth/oidc/callback

# Claim name in the ID token that carries group membership (JumpCloud default: "groups").
OIDC_GROUP_CLAIM=groups

# Map JumpCloud group names to Certharbor roles. Precedence: admin > manager > viewer.
# Leave a mapping empty to skip that role level.
OIDC_GROUP_ADMIN=step-ca-admins
OIDC_GROUP_MANAGER=step-ca-managers
OIDC_GROUP_VIEWER=step-ca-viewers

# Role to assign when no group matches. Leave empty to deny access (recommended).
OIDC_DEFAULT_ROLE=

# When true (default), the role is updated on every OIDC login so group membership
# stays authoritative. Set false to preserve manually assigned roles.
OIDC_SYNC_ROLE=true
