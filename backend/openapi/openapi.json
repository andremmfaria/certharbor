{
  "components": {
    "schemas": {
      "ConfigBody": {
        "additionalProperties": false,
        "properties": {
          "acmeEnabled": {
            "type": "boolean"
          },
          "appVersion": {
            "type": "string"
          },
          "contractSha": {
            "type": "string"
          },
          "expiringSoonDays": {
            "format": "int64",
            "type": "integer"
          },
          "localLoginEnabled": {
            "type": "boolean"
          },
          "oidcButtonLabel": {
            "type": "string"
          },
          "oidcEnabled": {
            "type": "boolean"
          },
          "roleLevels": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "sessionIdleTimeoutSeconds": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "oidcEnabled",
          "localLoginEnabled",
          "oidcButtonLabel",
          "acmeEnabled",
          "appVersion",
          "contractSha",
          "roleLevels",
          "sessionIdleTimeoutSeconds",
          "expiringSoonDays"
        ],
        "type": "object"
      },
      "CreateSessionBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "Account password.",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "description": "Account username.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "anonymous",
              "pendingMfa",
              "authenticated"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserBody"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "SessionUserBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "SpikeUploadBody": {
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string"
          },
          "sizeBytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "filename",
          "sizeBytes"
        ],
        "type": "object"
      },
      "StatusBody": {
        "additionalProperties": false,
        "properties": {
          "expiringSoon": {
            "items": {
              "$ref": "#/components/schemas/StatusExpiring"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "expiringSoon"
        ],
        "type": "object"
      },
      "StatusExpiring": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "format": "int64",
            "type": "integer"
          },
          "domain": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "domain",
          "days"
        ],
        "type": "object"
      },
      "SubmitMFABody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "The authenticator code, or a recovery code.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "codeType": {
            "description": "Whether code is an authenticator code or a recovery code.",
            "enum": [
              "totp",
              "recovery"
            ],
            "type": "string"
          }
        },
        "required": [
          "code",
          "codeType"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "description": "Encrypted session cookie, served as __Host-certharbor when SESSION_SECURE is on (D6). Role names in a requirement array are documentation: enforcement is server-side.",
        "in": "cookie",
        "name": "certharbor",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "certharbor",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/_spike/blob": {
      "get": {
        "operationId": "getSpikeBlob",
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Placeholder binary payload.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": [
              "viewer"
            ]
          }
        ],
        "summary": "Phase 0 spike: binary download mechanic",
        "tags": [
          "system"
        ],
        "x-required-role": "viewer"
      }
    },
    "/api/v1/_spike/upload": {
      "post": {
        "operationId": "postSpikeUpload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "file": {
                  "contentType": "application/octet-stream"
                }
              },
              "schema": {
                "properties": {
                  "file": {
                    "contentEncoding": "binary",
                    "contentMediaType": "application/octet-stream",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpikeUploadBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": [
              "manager"
            ]
          }
        ],
        "summary": "Phase 0 spike: multipart upload mechanic",
        "tags": [
          "system"
        ],
        "x-required-role": "manager"
      }
    },
    "/api/v1/config": {
      "get": {
        "operationId": "getConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Get public runtime configuration",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/session": {
      "delete": {
        "operationId": "deleteSession",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Log out and expire the session and CSRF cookies",
        "tags": [
          "session"
        ]
      },
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Get the current session state",
        "tags": [
          "session"
        ]
      },
      "post": {
        "operationId": "createSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Log in with a username and password",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/session/mfa": {
      "post": {
        "operationId": "submitMfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitMFABody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Complete a login with a second factor",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": [
              "viewer"
            ]
          }
        ],
        "summary": "Get active/expiring certificate counts",
        "tags": [
          "dashboard"
        ],
        "x-required-role": "viewer"
      }
    }
  }
}
