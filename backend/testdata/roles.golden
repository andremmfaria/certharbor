# The role golden table. One row per registered operation, sorted by method
# then path. Columns are space-separated key=value pairs after the method and
# path, and every column is required.
#
# The role-matrix test reads the in-process registered operation set, not the
# committed spec: huma.Operation.Metadata is tagged yaml:"-" upstream and
# never reaches the serialised document, so a test parsing openapi.json would
# see nothing. Adding an operation without updating this file fails the build.
#
# There is no version column. /v1 is permanent by construction (5.1, Q5), so
# the column would hold one constant value in every row.
#
# templateRouteRetired is false until Phase 9 deletes the server-rendered
# route this operation replaces, and the count of false rows reaching zero is
# a Phase 9 exit criterion (R22). It is true for an operation that never had
# a template route.
GET  /api/v1/_spike/blob   auth=required role=viewer  tag=system      csrf=no  ratelimit=no templateRouteRetired=true
DELETE /api/v1/session     auth=public   role=-       tag=session     csrf=optional ratelimit=no templateRouteRetired=false
GET  /api/v1/certificates  auth=required role=viewer  tag=certificates csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/certificates/{id} auth=required role=viewer  tag=certificates csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/certificates/{id}/certificate auth=required role=manager tag=certificates csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/certificates/{id}/key auth=required role=manager tag=certificates csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/certificates/options auth=required role=manager tag=certificates csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/certificates/import-candidates auth=required role=manager tag=certificates csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/history       auth=required role=viewer  tag=system      csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/provisioners  auth=required role=viewer  tag=provisioners csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/security/events auth=required role=admin   tag=security    csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/audit-events  auth=required role=admin   tag=security    csrf=no  ratelimit=no templateRouteRetired=false
DELETE /api/v1/security/ip-blocks/{ip} auth=required role=admin tag=security csrf=yes ratelimit=no templateRouteRetired=false
GET  /api/v1/ca            auth=required role=viewer  tag=ca          csrf=no  ratelimit=no templateRouteRetired=true
GET  /api/v1/dashboard     auth=required role=viewer  tag=dashboard   csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/admin/console/commands auth=required role=admin tag=admin csrf=no ratelimit=no templateRouteRetired=false
POST /api/v1/admin/console/run auth=required role=admin tag=admin csrf=yes ratelimit=no templateRouteRetired=false
GET  /api/v1/admin/about  auth=required role=admin  tag=admin       csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/admin/integrity auth=required role=admin tag=admin    csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/ca/root       auth=required role=admin   tag=ca          csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/ca/intermediate auth=required role=admin   tag=ca          csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/ca/chain      auth=required role=admin   tag=ca          csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/config        auth=public   role=-       tag=system      csrf=no  ratelimit=no templateRouteRetired=true
GET  /api/v1/session       auth=optional role=-       tag=session     csrf=no  ratelimit=no templateRouteRetired=true
GET  /api/v1/status        auth=required role=viewer  tag=dashboard   csrf=no  ratelimit=no templateRouteRetired=false
POST /api/v1/_spike/upload auth=required role=manager tag=system      csrf=yes ratelimit=no templateRouteRetired=true
POST /api/v1/certificates  auth=required role=manager tag=certificates csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/certificates/import/paths auth=required role=manager tag=certificates csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/certificates/import/upload auth=required role=manager tag=certificates csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/certificates/{id}/renew auth=required role=manager tag=certificates csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/certificates/{id}/revoke auth=required role=admin tag=certificates csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/session       auth=public   role=-       tag=session     csrf=yes ratelimit=yes templateRouteRetired=false
POST /api/v1/session/mfa   auth=public   role=-       tag=session     csrf=yes ratelimit=yes templateRouteRetired=false

# Phase 6, step 1 (plans/frontend-backend-split.md Section 8): Users and
# temporary users. All admin, same as the template chain's /admin/users
# tree today. deleteTemporaryUser has no legacy template route (the
# admin_users_temp page never gained a delete action), so it is
# templateRouteRetired=true; every other row here replaces a route that
# stays registered until Phase 9 (R22).
GET  /api/v1/users         auth=required role=admin   tag=users       csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/users/{id}    auth=required role=admin   tag=users       csrf=no  ratelimit=no templateRouteRetired=false
POST /api/v1/users         auth=required role=admin   tag=users       csrf=yes ratelimit=no templateRouteRetired=false
PATCH /api/v1/users/{id}   auth=required role=admin   tag=users       csrf=yes ratelimit=no templateRouteRetired=false
DELETE /api/v1/users/{id}  auth=required role=admin   tag=users       csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/users/{id}/password-reset auth=required role=admin tag=users csrf=yes ratelimit=no templateRouteRetired=false
GET  /api/v1/temporary-users auth=required role=admin tag=users      csrf=no  ratelimit=no templateRouteRetired=false
POST /api/v1/temporary-users auth=required role=admin tag=users      csrf=yes ratelimit=no templateRouteRetired=false
DELETE /api/v1/temporary-users/{id} auth=required role=admin tag=users csrf=yes ratelimit=no templateRouteRetired=true

GET  /api/v1/admin/backups auth=required role=admin   tag=admin       csrf=no  ratelimit=no templateRouteRetired=false
POST /api/v1/admin/backups auth=required role=admin   tag=admin       csrf=yes ratelimit=no templateRouteRetired=false
GET  /api/v1/admin/backups/{id}/download auth=required role=admin   tag=admin       csrf=no  ratelimit=no templateRouteRetired=true
GET  /api/v1/admin/notifications auth=required role=admin   tag=admin       csrf=no  ratelimit=no templateRouteRetired=false
PATCH /api/v1/admin/notifications auth=required role=admin   tag=admin       csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/admin/notifications/test auth=required role=admin   tag=admin       csrf=yes ratelimit=no templateRouteRetired=false

# Phase 7 (plans/frontend-backend-split.md Section 8 "### ACME"): the full
# ACME surface across its three steps (#53 rename, #54 certificates/options/
# downloads, #55 settings/events). Every row is manager, same as the
# template chain's /le/* tree today.
GET  /api/v1/acme/certificates auth=required role=manager tag=acme         csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/acme/options  auth=required role=manager tag=acme         csrf=no  ratelimit=no templateRouteRetired=false
POST /api/v1/acme/certificates auth=required role=manager tag=acme         csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/acme/certificates/{id}/renew auth=required role=manager tag=acme csrf=yes ratelimit=no templateRouteRetired=false
DELETE /api/v1/acme/certificates/{id} auth=required role=manager tag=acme  csrf=yes ratelimit=no templateRouteRetired=false
PATCH /api/v1/acme/certificates/{id} auth=required role=manager tag=acme   csrf=yes ratelimit=no templateRouteRetired=false
GET  /api/v1/acme/certificates/{id}/certificate auth=required role=manager tag=acme csrf=no ratelimit=no templateRouteRetired=false
GET  /api/v1/acme/certificates/{id}/key auth=required role=manager tag=acme csrf=no ratelimit=no templateRouteRetired=false
GET  /api/v1/acme/settings auth=required role=manager tag=acme         csrf=no  ratelimit=no templateRouteRetired=false
PATCH /api/v1/acme/settings auth=required role=manager tag=acme         csrf=yes ratelimit=no templateRouteRetired=false
GET  /api/v1/acme/events  auth=required role=manager tag=acme         csrf=no  ratelimit=no templateRouteRetired=false
GET  /api/v1/profile      auth=required role=viewer  tag=profile      csrf=no  ratelimit=no templateRouteRetired=false
PATCH /api/v1/profile     auth=required role=viewer  tag=profile      csrf=yes ratelimit=no templateRouteRetired=false
PATCH /api/v1/profile/preferences auth=required role=viewer tag=profile csrf=yes ratelimit=no templateRouteRetired=false
POST /api/v1/profile/password auth=required role=viewer tag=profile  csrf=yes ratelimit=no templateRouteRetired=false
