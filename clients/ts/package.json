{
  "name": "@andremmfaria/step-ca-webui-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client generated from backend/openapi/openapi.json (plans/frontend-backend-split.md, D4). Generated by the backend's CI on every push and pull request, published to GitHub Packages on a v* tag, and consumed by frontend as a path-resolved tarball, never as a declared dependency (D8).",
  "license": "SEE LICENSE IN ../../LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andremmfaria/step-ca-webui.git",
    "directory": "clients/ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.gen.d.ts",
      "import": "./dist/client.gen.js"
    },
    "./react-query": {
      "types": "./dist/@tanstack/react-query.gen.d.ts",
      "import": "./dist/@tanstack/react-query.gen.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run generate && npm run build",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --ignore-rules internal-resolution-error"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@tanstack/react-query": "5.106.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
